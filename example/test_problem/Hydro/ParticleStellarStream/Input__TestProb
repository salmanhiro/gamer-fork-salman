# problem-specific runtime parameters
ParStream_Dens_Bg        1.0e-10         # background mass density [1.0e-2]
ParStream_Pres_Bg        1.0e-10         # background energy density [1.0e-2]
ParStream_Ang_Freq       1.0e-10         # gas angular speed [0.00051668]
ParStream_Mass           1.0e-10         # the mass of the active particles [1.0]
ParStream_Use_Tracers    0               # whether to use tracer particles [1]
ParStream_Use_Massive    1               # whether to use massive particles [1]
ParStream_SigmaX         1.0            # x axis 1D velocity dispersion in km/s [1]
ParStream_SigmaY         1.0            # y axis 1D velocity dispersion in km/s [1]
ParStream_SigmaZ         1.0            # z axis 1D velocity dispersion in km/s [1]
ParStream_Width          1.0             # stream width in kpc [1.0]
ParStream_BulkSigmaX     120.0           # x axis stream bulk velocity in km/s [120.0]
ParStream_BulkSigmaY     0.0             # y axis stream bulk velocity in km/s [0.0]
ParStream_BulkSigmaZ     0.0             # z axis stream bulk velocity in km/s [0.0]